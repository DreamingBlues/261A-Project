# (a) Time to containment
hist(
fire$Duration,
breaks = 50,
main = "(a) Distribution of Time to Containment",
xlab = "Time to Containment (Days)"
)
# (b) Log time to containment
hist(
fire$Log.Duration,
breaks = 50,
main = "(b) Distribution of Log Time",
xlab = "Log(Time to Containment + 1)"
)
# (c) Acres burned
hist(
fire$GIS.Calculated.Acres,
